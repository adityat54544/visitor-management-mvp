# Server port
PORT=5000

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/mvp
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mvp
MONGODB_URI=mongodb://127.0.0.1:27017/mvp

# JWT signing secret (change in production!)
JWT_SECRET=dev-secret-change-me

# Allowed CORS origin (your mobile / web client)
CLIENT_ORIGIN=*

# Demo admin login (seeded on first boot)
DEMO_EMAIL=admin@visitor.app
DEMO_PASSWORD=admin123